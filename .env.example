# Set variables in Railway. For local use: node --env-file=.env server.mjs
DATABASE_URL=postgresql://worklio:change-me@localhost:5432/worklio
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Replace with a random value of at least 32 characters before first launch.
SETUP_TOKEN=replace-with-a-random-setup-token-at-least-32-characters
PG_POOL_MAX=10
# NODE_ENV=production requires DATABASE_URL. Hosted origins must use HTTPS.
